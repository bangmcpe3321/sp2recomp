+}
+
+static void fps_overlay_tick() {
+    static uint64_t previous_ns = 0, previous_frames = 0;
+    const uint64_t now = monotonic_ns();
+    const uint64_t frames = g_fps_counters.frames.load(std::memory_order_acquire);
+    const uint64_t last = g_fps_counters.last_ns.load(std::memory_order_relaxed);
+    uint64_t peak = g_fps_counters.peak_ns.exchange(0, std::memory_order_relaxed);
+    if (last && now >= last) peak = std::max(peak, now - last); // A stall is visible before the next present.
+    if (previous_ns && now > previous_ns) {
+        const uint64_t count = frames - previous_frames;
+        const double fps = double(count) * 1e9 / double(now - previous_ns);
+        if (count)
+            std::swprintf(g_fps_text, sizeof g_fps_text / sizeof *g_fps_text,
+                          L"%.1f FPS\n%.1f ms | peak %.1f ms", fps,
+                          double(now - previous_ns) / double(count) / 1e6, double(peak) / 1e6);
+        else
+            std::swprintf(g_fps_text, sizeof g_fps_text / sizeof *g_fps_text,
+                          L"0.0 FPS\nFrame stalled | %.0f ms", double(peak) / 1e6);
+    }
+    previous_ns = now, previous_frames = frames;
+    fps_overlay_position();
+    if (g_fps_window && IsWindowVisible(g_fps_window)) InvalidateRect(g_fps_window, nullptr, FALSE);
+}
+
+static LRESULT CALLBACK fps_overlay_proc(HWND h, UINT msg, WPARAM w, LPARAM l) {
+    switch (msg) {
+        case WM_NCHITTEST: return HTTRANSPARENT;
+        case WM_MOUSEACTIVATE: return MA_NOACTIVATE;
+        case WM_ERASEBKGND: return 1;
+        case WM_PAINT: {
+            PAINTSTRUCT paint{};
+            HDC dc = BeginPaint(h, &paint);
+            RECT rect{}; GetClientRect(h, &rect);
+            FillRect(dc, &rect, static_cast<HBRUSH>(GetStockObject(BLACK_BRUSH)));
+            SetBkMode(dc, TRANSPARENT);
+            SetTextColor(dc, RGB(225, 255, 225));
+            HGDIOBJ previous = g_fps_font ? SelectObject(dc, g_fps_font) : nullptr;
+            const int padding = MulDiv(7, g_fps_dpi ? g_fps_dpi : 96, 96);
+            rect.left += padding, rect.top += padding;
+            DrawTextW(dc, g_fps_text, -1, &rect, DT_LEFT | DT_NOPREFIX);
+            if (previous) SelectObject(dc, previous);
+            EndPaint(h, &paint);
+            return 0;
+        }
+    }
+    return DefWindowProcW(h, msg, w, l);
+}
