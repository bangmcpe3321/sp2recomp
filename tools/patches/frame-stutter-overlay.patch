+// ---- FPS overlay ----------------------------------------------------------------------------------------------
+// A small owned, click-through window is composed above the Vulkan surface. Only
+// the window thread draws text, at 4 Hz; the render thread updates a few counters.
+struct FpsCounters {
+    std::atomic<uint64_t> frames{0}, last_ns{0}, peak_ns{0};
+    void presented(uint64_t now) {
+        const uint64_t previous = last_ns.exchange(now, std::memory_order_relaxed);
+        if (previous && now >= previous) {
+            const uint64_t gap = now - previous;
+            uint64_t peak = peak_ns.load(std::memory_order_relaxed);
+            while (peak < gap && !peak_ns.compare_exchange_weak(peak, gap, std::memory_order_relaxed)) {}
+        }
+        frames.fetch_add(1, std::memory_order_release);
+    }
+};
+static FpsCounters g_fps_counters;
+void fps_presented(uint64_t now) { g_fps_counters.presented(now); }
