+// A bounded pipeline cache. Hits retain recently used pipelines; destruction is deferred by the caller.
+#pragma once
+#include <cstddef>
+#include <list>
+#include <unordered_map>
+#include <utility>
+namespace nx::nvn {
+template<class Key, class Value, class Hash> class PipelineLru {
+    using Order=std::list<Key>;
+    struct Entry { Value value; typename Order::iterator position; };
+    using Entries=std::unordered_map<Key,Entry,Hash>;
+    Order order_;
+    Entries entries_;
+    const typename Entries::value_type* last_=nullptr;
+    size_t capacity_;
+public:
+    explicit PipelineLru(size_t capacity):capacity_(capacity) {}
+    size_t size() const { return entries_.size(); }
+    const Value* find(const Key& key) {
+        // Consecutive hits are already most recent. Unordered-map rehash preserves entry pointers.
+        if (last_ && last_->first==key) return &last_->second.value;
+        auto found=entries_.find(key);
+        if (found==entries_.end()) return nullptr;
+        order_.splice(order_.end(),order_,found->second.position);
+        last_=&*found;
+        return &found->second.value;
+    }
+    template<class Retire> void insert(const Key& key,Value value,Retire retire) {
+        auto position=order_.insert(order_.end(),key);
+        auto [entry,added]=entries_.emplace(key,Entry{value,position});
+        if (!added) { // Defensive replacement: retire the old resource, retaining its original order node.
+            order_.erase(position);
+            retire(entry->second.value);
+            entry->second.value=value;
+            order_.splice(order_.end(),order_,entry->second.position);
+        }
+        last_=&*entry;
+        while (capacity_ && entries_.size()>capacity_) {
+            auto old=entries_.find(order_.front());
+            if (last_==&*old) last_=nullptr;
+            retire(old->second.value);
+            entries_.erase(old);
+            order_.pop_front();
+        }
+    }
+};
+} // namespace nx::nvn
