+                                  wc.lpszClassName, L"Performance", WS_POPUP, 0, 0, 270, 52,
+                                  owner, nullptr, wc.hInstance, nullptr);
+    if (!g_fps_window) return;
+    SetLayeredWindowAttributes(g_fps_window, 0, 225, LWA_ALPHA);
+    SetTimer(owner, kFpsTimer, 250, nullptr);
+    fps_overlay_tick();
