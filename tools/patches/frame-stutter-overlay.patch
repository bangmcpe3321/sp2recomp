+static HFONT g_fps_font = nullptr;
+static UINT g_fps_dpi = 0;
+static bool g_fps_enabled = true;
+static wchar_t g_fps_text[128] = L"FPS: --\nFrame: -- ms";
+
+static void fps_overlay_position() {
+    if (!g_fps_window) return;
+    if (!g_fps_enabled || !g_window || !IsWindowVisible(g_window) || IsIconic(g_window) ||
+        GetForegroundWindow() != g_window) {
+        ShowWindow(g_fps_window, SW_HIDE);
+        return;
+    }
+    const UINT dpi = std::max<UINT>(96, GetDpiForWindow(g_window));
+    if (dpi != g_fps_dpi) {
+        if (g_fps_font) DeleteObject(g_fps_font);
+        g_fps_font = CreateFontW(-MulDiv(16, dpi, 96), 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE,
+                                DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
+                                CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_MODERN, L"Consolas");
+        g_fps_dpi = dpi;
+    }
+    POINT point{MulDiv(8, dpi, 96), MulDiv(8, dpi, 96)};
+    ClientToScreen(g_window, &point);
+    SetWindowPos(g_fps_window, HWND_TOP, point.x, point.y, MulDiv(270, dpi, 96), MulDiv(52, dpi, 96),
