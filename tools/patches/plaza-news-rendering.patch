+// Preserve sine's small nonzero value near +/-pi. Native approximate sine can
+// round these arguments to zero; area-light shaders then take its reciprocal.
+// Reduce around a split pi before evaluating sine, without changing other inputs.
+static bool stable_sine_near_pi(const std::vector<uint32_t>& in, std::vector<uint32_t>& out) {
+    if (in.size() < 5 || in[0] != 0x07230203 || !in[3] || in[3] > 10000000) return false;
+    uint32_t glsl = 0, boolean = 0, scalar = 0, functions = 0;
+    bool in_function = false;
+    std::set<uint32_t> floats;
+    for (size_t i = 5; i < in.size();) {
+        uint32_t n = in[i] >> 16, op = in[i] & 0xffff;
+        if (!n || n > in.size() - i) return false;
+        const uint32_t* w = &in[i];
+        if (op == 11 && n >= 6 && std::memcmp(w + 2, "GLSL.std.450\0", 13) == 0) glsl = w[1];
+        if (op == 54) { if (in_function) return false; in_function = true; functions++; }
+        if (op == 56) { if (!in_function) return false; in_function = false; }
+        if (op == 20 && n == 2) boolean = w[1];
+        if (op == 22 && n == 3 && w[2] == 32) floats.insert(w[1]);
+        i += n;
+    }
+    if (!glsl || in_function || !functions) return false;
+    uint32_t count = 0;
+    for (size_t i = 5; i < in.size(); i += in[i] >> 16) {
+        const uint32_t* w = &in[i];
+        if ((w[0] & 0xffff) == 12 && (w[0] >> 16) == 6 && w[3] == glsl && w[4] == 13 && floats.count(w[1])) {
+            if (scalar && scalar != w[1]) return false;
+            scalar = w[1]; count++;
+        }
+    }
+    if (!count || uint64_t(in[3]) + 10ull * count + 5 > UINT32_MAX) return false;
+    uint32_t next = in[3];
+    auto id = [&]() { return next++; };
+    std::vector<uint32_t> declarations, decorations, body;
+    if (!boolean) { boolean = id(); declarations.insert(declarations.end(), {2u << 16 | 20, boolean}); }
+    uint32_t constants[4];
+    // pi_hi + pi_lo approximates mathematical pi much more closely than one float.
+    const float values[4] = {3.1415927410125732f, -8.742277657347586e-8f, 0.001f, 0.0f};
+    for (unsigned k = 0; k < 4; k++) {
+        uint32_t bits; std::memcpy(&bits, &values[k], sizeof bits);
+        constants[k] = id();
+        declarations.insert(declarations.end(), {4u << 16 | 43, scalar, constants[k], bits});
+    }
+    for (size_t i = 5; i < in.size(); i += in[i] >> 16) {
+        const uint32_t* w = &in[i]; uint32_t n = w[0] >> 16;
+        if ((w[0] & 0xffff) != 12 || n != 6 || w[3] != glsl || w[4] != 13 || w[1] != scalar) {
+            body.insert(body.end(), w, w + n); continue;
+        }
+        uint32_t a = id(), d = id(), ad = id(), close_pi = id(), r = id(), s = id(), neg = id(), negative = id(), signed_s = id(), original = id();
+        body.insert(body.end(), {
+            6u << 16 | 12, scalar, a, glsl, 4, w[5], // abs(x)
+            5u << 16 | 131, scalar, d, a, constants[0],
+            6u << 16 | 12, scalar, ad, glsl, 4, d,
+            5u << 16 | 184, boolean, close_pi, ad, constants[2],
+            5u << 16 | 131, scalar, r, d, constants[1],
+            6u << 16 | 12, scalar, s, glsl, 13, r,
+            4u << 16 | 127, scalar, neg, s,
+            5u << 16 | 184, boolean, negative, w[5], constants[3],
+            6u << 16 | 169, scalar, signed_s, negative, s, neg,
+            6u << 16 | 12, scalar, original, glsl, 13, w[5],
+            6u << 16 | 169, scalar, w[2], close_pi, signed_s, original});
+        decorations.insert(decorations.end(), {3u << 16 | 71, d, 42, 3u << 16 | 71, r, 42}); // NoContraction
+    }
+    std::vector<uint32_t> result(in.begin(), in.begin() + 5);
+    bool annotated = false, declared = false;
+    for (size_t i = 0; i < body.size(); i += body[i] >> 16) {
+        uint32_t n = body[i] >> 16, op = body[i] & 0xffff;
+        if (!annotated && op >= 19 && op <= 39) {
+            result.insert(result.end(), decorations.begin(), decorations.end()); annotated = true;
+        }
+        if (!declared && op == 54) {
+            result.insert(result.end(), declarations.begin(), declarations.end()); declared = true;
+        }
+        result.insert(result.end(), body.begin() + i, body.begin() + i + n);
+    }
+    if (!annotated || !declared) return false;
+    result[3] = next; out = std::move(result); return true;
+}
