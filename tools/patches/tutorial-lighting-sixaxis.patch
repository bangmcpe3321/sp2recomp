+void readback_linear_texture(VkCommandBuffer cb, const Texture& t, GpuImage& img, std::vector<WriteBack>& writes) {
+    if (!(t.flags & 0x40) || !t.memory || !t.stride || t.levels != 1 || t.depth != 1 ||
+        img.levels != 1 || img.layers != 1 || img.depth != 1 || t.samples > 1 ||
+        img.aspect != VK_IMAGE_ASPECT_COLOR_BIT || img.format != vk_format(t.format)) return;
+    uint32_t bw = 0, bh = 0, bytes = 0;
+    format_block(t.format, bw, bh, bytes);
+    if (bw != 1 || bh != 1 || !bytes || bytes != vk_block_bytes(img.format) ||
+        !img.width || !img.height || img.width != t.width || img.height != t.height) return;
+    const uint64_t row = uint64_t(img.width) * bytes;
+    const uint64_t span = uint64_t(img.height - 1) * t.stride + row;
+    if (row > t.stride || (t.storage_size && span > t.storage_size) || span > (64ull << 20) ||
+        t.memory > UINT64_MAX - span) return;
+    const uint32_t alignment = std::lcm(4u, bytes);
+    Upload u = upload_alloc(row * img.height + alignment, 16);
+    const uint64_t shift = (alignment - u.offset % alignment) % alignment;
+    u.offset += shift;
+    u.ptr += shift;
+    VkImageLayout back = img.layout;
+    transition(cb, img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    VkBufferImageCopy r{};
+    r.bufferOffset = u.offset;
+    r.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    r.imageExtent = {img.width, img.height, 1};
+    p_vkCmdCopyImageToBuffer(cb, img.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, u.buffer, 1, &r);
+    transition(cb, img, back);
+    VkMemoryBarrier mb{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    mb.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    mb.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+    p_vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &mb, 0, nullptr, 0, nullptr);
+    // Copy only texels, not pitch padding. The upload allocation remains mapped and alive until the submit retires.
+    auto* guest = reinterpret_cast<uint8_t*>(t.memory);
+    for (uint32_t y = 0; y < img.height; y++)
+        writes.push_back({u.ptr + y * row, guest + uint64_t(y) * t.stride, row, {}});
