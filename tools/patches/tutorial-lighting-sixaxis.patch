+            break;
+        case 23:  // OpTypeVector
+            if (len != 4 || !valid(w[1]) || !valid(w[2])) return false;
+            ids[w[1]].vec4 = ids[w[2]].float32 && w[3] == 4;
+            break;
+        case 32:  // OpTypePointer: only Output pointers matter
+            if (len != 4 || !valid(w[1]) || !valid(w[3])) return false;
+            if (w[2] == 3) ids[w[1]].pointee = w[3];
+            break;
+        case 43:  // OpConstant
+            if (len == 4) {
+                if (!valid(w[1]) || !valid(w[2])) return false;
