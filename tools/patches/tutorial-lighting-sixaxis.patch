+        uint32_t bits = 0, pointee = 0, structure = 0, component = 0;
+        int builtin = -1;
+        Kind pointer = Other;
+        bool float32 = false, vec4 = false, scalar = false, float_constant = false, center = false;
+    };
+    std::vector<Id> ids(in[3]);
+    std::map<std::pair<uint32_t, uint32_t>, uint32_t> members;
+    unsigned functions = 0, returns = 0, positions = 0, sizes = 0;
+    auto valid = [&](uint32_t id) { return id < ids.size(); };
