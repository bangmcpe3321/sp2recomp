+// A conservative proof for constant, single-pixel reduction points. Do not infer this from a shader hash:
+// all Position/PointSize stores must be constant, with no control flow, calls or pointer aliases.
+bool constant_unit_point_module(const std::vector<uint32_t>& in) {
+    if (in.size() < 5 || in[0] != 0x07230203 || !in[3] || in[3] > (1u << 20)) return false;
+    enum Kind { Other, Block, Position, PointSize, Component };
