@@ -0,0 +1,50 @@
+// Mouse displacement becomes controller motion, independent of the game's frame rate.
+#pragma once
+#include <cmath>
+#include <cstdint>
+namespace nx::plat {
+struct MouseGyroSample {
+    uint64_t delta_ns = 16666667;
+    float acceleration[3] = {0, 0, -1};
+    float velocity[3] = {}; // revolutions/second, as required by nn::hid
+    float angle[3] = {};    // revolutions
+    float direction[9] = {1,0,0, 0,1,0, 0,0,1};
+};
+// Caller serializes UI updates and sensor reads. Each Joy-Con has its own read cursor.
+class MouseGyro {
+    struct Cursor { double pitch=0, yaw=0; uint64_t ns=0; } cursors_[2];
+    double pitch_=0, yaw_=0;
+    bool captured_=false;
+public:
+    void capture(bool on, uint64_t now) {
+        captured_=on;
+        for (auto& c:cursors_) c={pitch_,yaw_,now};
+    }
+    void move(int32_t dx, int32_t dy, double degrees_per_pixel) {
+        if (!captured_ || !std::isfinite(degrees_per_pixel)) return;
+        // Mouse up tilts up; mouse right turns right. No stick deadzone or speed cap.
+        pitch_ -= double(dy)*degrees_per_pixel/360.0;
+        yaw_ += double(dx)*degrees_per_pixel/360.0;
+    }
+    MouseGyroSample sample(unsigned sensor, uint64_t now) {
+        MouseGyroSample s;
+        auto& c=cursors_[sensor & 1];
+        if (c.ns && now>c.ns) s.delta_ns=now-c.ns;
+        if (captured_ && c.ns && now>c.ns) {
+            s.velocity[0]=float((pitch_-c.pitch)*1e9/double(s.delta_ns));
+            s.velocity[1]=float((yaw_-c.yaw)*1e9/double(s.delta_ns));
+        }
+        // Equal-time reads must not consume motion intended for the next sample.
+        if (!c.ns || now>c.ns) c={pitch_,yaw_,now};
+        s.angle[0]=float(pitch_); s.angle[1]=float(yaw_);
+        constexpr double tau=6.2831853071795864769;
+        const double p=std::remainder(pitch_,1.0)*tau, y=std::remainder(yaw_,1.0)*tau;
+        const double cp=std::cos(p), sp=std::sin(p), cy=std::cos(y), sy=std::sin(y);
+        const float m[9]={float(cy),float(sy*sp),float(sy*cp),0,float(cp),float(-sp),float(-sy),float(cy*sp),float(cy*cp)};
+        for (int k=0;k<9;k++) s.direction[k]=m[k];
+        s.acceleration[0]=-m[2]; s.acceleration[1]=-m[5]; s.acceleration[2]=-m[8];
+        return s;
+    }
+};
+bool read_mouse_gyro(unsigned sensor, MouseGyroSample& sample);
+} // namespace nx::plat
