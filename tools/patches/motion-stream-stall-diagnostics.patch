+static bool stall_sampler_requested() {
+    // Sampling all guest threads every 5 ms is a diagnostic, especially costly during a real stall.
+    // Normal play keeps the 1 Hz hang watchdog, without sampling locks or per-thread stall reports.
+    if (const char* e=std::getenv("NX_STALL_SAMPLER")) return std::atoi(e)!=0;
+    return std::getenv("NX_THREAD_DUMP_AT") || std::getenv("NX_CPU_LOG") || std::getenv("NX_NATIVE_LOG");
+}
 void kernel_init() {
     plat::start_thread(watchdog, nullptr, 1ull << 20);
-    plat::start_thread(stall_sampler, nullptr, 1ull << 20);
+    if (stall_sampler_requested()) plat::start_thread(stall_sampler, nullptr, 1ull << 20);
 }
 
