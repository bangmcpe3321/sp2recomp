+// NVN timestamp reports execute on the GPU; CPU replay time is not GPU work.
+// Included once by nvn_draw_state.cpp. Calls are serialized by the existing GPU lock.
+#pragma once
+#include <cmath>
+#include <map>
+#include <vector>
+#include "nvn_vk.h"
+#include "platform.h"
+namespace nx::nvn {
+using namespace nx::vk;
+uint32_t vk_queue_family();
+namespace {
+constexpr uint32_t kCounterQueries=4096;
+struct CounterDestination { uint8_t* destination; uint64_t value; bool publish=true; };
+constexpr uint32_t kOcclusionQueries=8192;
+struct SamplesOperation {
+    enum Kind { Reset, Segment, Report } kind;
+    uint32_t index=0;
+};
+struct SamplesDestination { uint8_t* destination; uint32_t timestamp_report; uint64_t value=0; bool valid=false; };
+struct CounterBatch {
+    VkQueryPool pool=VK_NULL_HANDLE, samples_pool=VK_NULL_HANDLE;
+    std::vector<CounterDestination> reports;
+    std::vector<SamplesOperation> samples_operations;
+    std::vector<SamplesDestination> samples_destinations;
+    uint32_t samples_queries=0;
+    int samples_open=-1;
+    bool samples_prepared=false;
+};
+std::map<VkCommandBuffer,CounterBatch> g_counter_batches;
+// Recording state determines which passes need a query. Completed state is updated
+// in GPU submission order, including resets/reports in different command buffers.
+bool g_samples_recording=false, g_samples_valid=true;
+uint64_t g_samples_total=0;
+bool occlusion_counters_supported() {
+    static const bool supported=[] {
+        if (const char* e=std::getenv("NX_OCCLUSION_COUNTERS");e && std::atoi(e)==0) return false;
+        // Approximate occlusion queries may return only a nonzero indicator. Ink
+        // coverage needs the exact number of passed samples, not that indicator.
+        const bool precise=vk_features().occlusionQueryPrecise;
+        if (!precise) log("nvn/vk: precise occlusion queries unsupported; sample counter reports left unchanged");
+        return precise;
+    }();
+    return supported;
+}
+bool counter_destination_overlaps(uint8_t* destination,const std::vector<WriteBack>* writes) {
+    bool overlaps=replay::written_overlaps(destination,16);
+    if (writes) for (const WriteBack& write:*writes) {
+        const uintptr_t a=reinterpret_cast<uintptr_t>(destination), b=reinterpret_cast<uintptr_t>(write.to);
+        overlaps|=a>=b ? a-b<write.size : b-a<16;
+    }
+    if (overlaps) {
+        static unsigned warnings=0;
+        if (warnings++<4) log("nvn/vk: GPU counter overlaps compute write-back; retaining compute result (ordered counter/SSBO aliases unsupported)");
+    }
+    return overlaps;
+}
+// Align the GPU epoch once to the host clock. Keeping this offset fixed preserves
+// GPU durations across submits; aligning every batch separately would restore CPU jitter.
+struct CounterClock {
+    long double period=1, gpu_anchor=0, host_anchor=0;
+    uint32_t bits=64;
+    bool anchored=false;
+    long double unwrap(uint64_t ticks,uint64_t host_now) const {
+        if (bits>=64) return static_cast<long double>(ticks);
+        const uint64_t mask=(uint64_t(1)<<bits)-1;
+        const long double span=std::ldexp(1.0L,int(bits));
+        long double raw=static_cast<long double>(ticks&mask);
+        if (!anchored) return raw;
+        // Closest epoch to the advancing clock also handles wraps while no reports were queued.
+        const long double expected=gpu_anchor+(static_cast<long double>(host_now)-host_anchor)/period;
+        return raw+std::round((expected-raw)/span)*span;
+    }
+    void anchor(uint64_t latest_ticks,uint64_t host_now) {
+        if (anchored) return;
+        gpu_anchor=unwrap(latest_ticks,host_now);host_anchor=static_cast<long double>(host_now);anchored=true;
+    }
+    uint64_t nanoseconds(uint64_t ticks,uint64_t host_now) const {
+        const long double value=host_anchor+(unwrap(ticks,host_now)-gpu_anchor)*period;
+        if (value<=0) return 0;
+        if (value>=static_cast<long double>(UINT64_MAX)) return UINT64_MAX;
+        return uint64_t(value);
+    }
+} g_counter_clock;
+bool gpu_counters_supported() {
+    static const bool supported=[] {
+        // Experimental GPU timing is opt-in until game pacing is independently
+        // verified. Real sample counts remain enabled regardless of this setting.
+        // The explicit timestamp switch takes precedence over the legacy alias.
+        const char* enabled=std::getenv("NX_GPU_TIMESTAMPS");
+        if (!enabled) enabled=std::getenv("NX_GPU_COUNTERS");
+        if (!enabled || std::atoi(enabled)==0) return false;
+        VkPhysicalDeviceProperties properties{};
+        p_vkGetPhysicalDeviceProperties(vk_physical(),&properties);
+        uint32_t count=0;p_vkGetPhysicalDeviceQueueFamilyProperties(vk_physical(),&count,nullptr);
+        std::vector<VkQueueFamilyProperties> families(count);
+        if (count) p_vkGetPhysicalDeviceQueueFamilyProperties(vk_physical(),&count,families.data());
+        const uint32_t family=vk_queue_family();
+        if (family>=count || !families[family].timestampValidBits || !(properties.limits.timestampPeriod>0)) return false;
+        g_counter_clock.period=properties.limits.timestampPeriod;
+        g_counter_clock.bits=families[family].timestampValidBits;
+        log("nvn/vk: GPU counter timestamps enabled (period %.3f ns, %u valid bits)",double(g_counter_clock.period),g_counter_clock.bits);
+        return true;
+    }();
+    return supported;
+}
+} // namespace
+// Call only when a command buffer is free to begin again. A failed/unsubmitted
+// buffer must not leave destinations to be published after a later submission.
+void counter_queries_discard(VkCommandBuffer cb) {
+    auto found=g_counter_batches.find(cb);
+    if (found!=g_counter_batches.end()) {
+        auto& batch=found->second;
+        batch.reports.clear();batch.samples_operations.clear();batch.samples_destinations.clear();
+        batch.samples_queries=0;batch.samples_open=-1;batch.samples_prepared=false;
+    }
+}
+bool counter_queries_pending(VkCommandBuffer cb) {
+    auto found=g_counter_batches.find(cb);
+    return found!=g_counter_batches.end() && (!found->second.reports.empty() || !found->second.samples_operations.empty());
+}
+bool counter_timestamp_report(VkCommandBuffer cb,uint32_t type,uint8_t* destination,uint64_t value) {
+    if ((type!=0 && type!=16) || !gpu_counters_supported()) return false;
+    auto& batch=g_counter_batches[cb];
+    if (!batch.pool) {
+        VkQueryPoolCreateInfo info{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+        info.queryType=VK_QUERY_TYPE_TIMESTAMP;info.queryCount=kCounterQueries;
+        if (p_vkCreateQueryPool(vk_device(),&info,nullptr,&batch.pool)!=VK_SUCCESS) {
+            batch.pool=VK_NULL_HANDLE;
+            return false;
+        }
+    }
+    if (batch.reports.size()>=kCounterQueries) {
+        static bool warned=false;
+        if (!warned) log("nvn/vk: too many GPU counter reports in one command buffer; excess reports left unchanged"),warned=true;
+        return true;
+    }
+    if (batch.reports.empty()) {
+        // vkCmdResetQueryPool must be outside a render pass. Existing draw state
+        // reopens the pass with its contents retained if another draw follows.
+        draw_end_rendering(cb);
+        p_vkCmdResetQueryPool(cb,batch.pool,0,kCounterQueries);
+    }
+    const uint32_t query=uint32_t(batch.reports.size());
+    p_vkCmdWriteTimestamp(cb,type==16?VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT:VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,batch.pool,query);
+    batch.reports.push_back({destination,value});
+    return true;
+}
+// Prepare outside rendering, then begin/end a query around each render-pass
+// segment. A reset/report closes the current pass first; another draw reopens it
+// with retained attachments. This avoids per-draw query overhead and query nesting.
+void counter_occlusion_prepare(VkCommandBuffer cb) {
+    if (!g_samples_recording || !occlusion_counters_supported()) return;
+    auto& batch=g_counter_batches[cb];
+    if (batch.samples_prepared) return;
+    if (!batch.samples_pool) {
+        VkQueryPoolCreateInfo info{VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+        info.queryType=VK_QUERY_TYPE_OCCLUSION;info.queryCount=kOcclusionQueries;
+        if (p_vkCreateQueryPool(vk_device(),&info,nullptr,&batch.samples_pool)!=VK_SUCCESS) {
+            batch.samples_pool=VK_NULL_HANDLE;return;
+        }
+    }
+    p_vkCmdResetQueryPool(cb,batch.samples_pool,0,kOcclusionQueries);
+    batch.samples_prepared=true;
+}
+void counter_occlusion_begin_pass(VkCommandBuffer cb) {
+    if (!g_samples_recording || !occlusion_counters_supported()) return;
+    auto& batch=g_counter_batches[cb];
+    if (!batch.samples_prepared || batch.samples_queries>=kOcclusionQueries) {
+        // Failed allocation/overflow invalidates this accumulation until a reset,
+        // instead of substituting guessed positive or zero coverage.
+        batch.samples_operations.push_back({SamplesOperation::Segment,UINT32_MAX});
+        static unsigned warnings=0;
+        if (warnings++<4) log("nvn/vk: occlusion query unavailable or exhausted; affected sample reports left unchanged");
+        return;
+    }
+    const uint32_t query=batch.samples_queries++;
+    p_vkCmdBeginQuery(cb,batch.samples_pool,query,VK_QUERY_CONTROL_PRECISE_BIT);
+    batch.samples_open=int(query);
+    batch.samples_operations.push_back({SamplesOperation::Segment,query});
+}
+void counter_occlusion_end_pass(VkCommandBuffer cb) {
+    auto found=g_counter_batches.find(cb);
+    if (found==g_counter_batches.end() || found->second.samples_open<0) return;
+    auto& batch=found->second;
+    p_vkCmdEndQuery(cb,batch.samples_pool,uint32_t(batch.samples_open));
+    batch.samples_open=-1;
+}
+bool counter_occlusion_pass_active(VkCommandBuffer cb) {
+    auto found=g_counter_batches.find(cb);
+    return found!=g_counter_batches.end() && found->second.samples_open>=0;
+}
+void counter_samples_reset(VkCommandBuffer cb,uint32_t type) {
+    if (type!=1) return;
+    draw_end_rendering(cb); // ends any prior query before changing the counter scope
+    g_samples_recording=occlusion_counters_supported();
+    if (!g_samples_recording) return;
+    auto& batch=g_counter_batches[cb];
+    batch.samples_operations.push_back({SamplesOperation::Reset});
+    counter_occlusion_prepare(cb);
+}
+bool counter_samples_report(VkCommandBuffer cb,uint8_t* destination) {
+    if (!g_samples_recording || !occlusion_counters_supported()) {
+        static unsigned warnings=0;
+        if (warnings++<4) log("nvn/vk: sample counter reported without a supported reset scope; destination left unchanged");
+        return true;
+    }
+    draw_end_rendering(cb); // completes this query segment before the report marker
+    auto& batch=g_counter_batches[cb];
+    const size_t before=batch.reports.size();
+    const bool timestamp=counter_timestamp_report(cb,0,destination,0) && batch.reports.size()>before;
+    const uint32_t report=uint32_t(batch.samples_destinations.size());
+    batch.samples_destinations.push_back({destination,timestamp?uint32_t(before):UINT32_MAX});
+    batch.samples_operations.push_back({SamplesOperation::Report,report});
+    return true;
+}
+
+// The caller has waited the command buffer's actual fence. No WAIT_BIT, spin,
+// per-report submit or extra fence is introduced; failure publishes no invented time.
+void counter_queries_collect(VkCommandBuffer cb,const std::vector<WriteBack>* pending_write_backs=nullptr) {
+    auto found=g_counter_batches.find(cb);
+    if (found==g_counter_batches.end()) return;
+    auto& batch=found->second;
+    if (batch.reports.empty() && batch.samples_operations.empty()) return;
+    std::vector<uint64_t> samples(batch.samples_queries);
+    const bool samples_ok=samples.empty() || p_vkGetQueryPoolResults(vk_device(),batch.samples_pool,0,uint32_t(samples.size()),samples.size()*sizeof(uint64_t),samples.data(),sizeof(uint64_t),VK_QUERY_RESULT_64_BIT)==VK_SUCCESS;
+    for (const SamplesOperation& operation:batch.samples_operations) {
+        if (operation.kind==SamplesOperation::Reset) { g_samples_total=0;g_samples_valid=true; }
+        else if (operation.kind==SamplesOperation::Segment) {
+            if (!samples_ok || operation.index>=samples.size()) g_samples_valid=false;
+            else g_samples_total+=samples[operation.index];
+        } else {
+            auto& report=batch.samples_destinations[operation.index];
+            report.value=g_samples_total;report.valid=g_samples_valid;
+            if (report.timestamp_report!=UINT32_MAX) {
+                auto& timestamp=batch.reports[report.timestamp_report];
+                timestamp.value=report.value;timestamp.publish=report.valid;
+            } else if (report.valid && !counter_destination_overlaps(report.destination,pending_write_backs)) {
+                // QueryInfoBuffer also uses the timestamp as its ready marker.
+                // In legacy timestamp mode publish completion time only after the
+                // GPU fence, including a legitimate zero samples-passed result.
+                const uint64_t completed[2]={report.value,plat::monotonic_ns()};
+                std::memcpy(report.destination,completed,sizeof completed);
+                replay::dedup_invalidate(report.destination,sizeof completed);
+            }
+        }
+    }
+    batch.samples_operations.clear();
+    std::vector<uint64_t> ticks(batch.reports.size());
+    const VkResult result=ticks.empty()?VK_SUCCESS:p_vkGetQueryPoolResults(vk_device(),batch.pool,0,uint32_t(ticks.size()),ticks.size()*sizeof(uint64_t),ticks.data(),sizeof(uint64_t),VK_QUERY_RESULT_64_BIT);
+    if (result==VK_SUCCESS) {
+        const uint64_t now=plat::monotonic_ns();
+        // First alignment uses the last completed marker, minimizing retirement delay.
+        if (!ticks.empty()) g_counter_clock.anchor(ticks.back(),now);
+        for (size_t k=0;k<ticks.size();k++) {
+            uint8_t* destination=batch.reports[k].destination;
+            if (!batch.reports[k].publish || counter_destination_overlaps(destination,pending_write_backs)) continue;
+            const uint64_t counter[2]={batch.reports[k].value,g_counter_clock.nanoseconds(ticks[k],now)};
+            std::memcpy(batch.reports[k].destination,counter,sizeof counter);
+            replay::dedup_invalidate(batch.reports[k].destination,sizeof counter);
+            replay::written_cpu_write(batch.reports[k].destination,sizeof counter);
+        }
+    } else {
+        static unsigned warnings=0;
+        if (warnings++<4) log("nvn/vk: completed GPU timestamp query unavailable (%d); timestamp left unchanged",int(result));
+        // A failed timestamp query must not discard an independently completed,
+        // valid samples-passed result. A nonzero completion time marks it ready.
+        for (const auto& report:batch.samples_destinations)
+            if (report.valid && report.timestamp_report!=UINT32_MAX && !counter_destination_overlaps(report.destination,pending_write_backs)) {
+                const uint64_t completed[2]={report.value,plat::monotonic_ns()};
+                std::memcpy(report.destination,completed,sizeof completed);
+                replay::dedup_invalidate(report.destination,sizeof completed);
+            }
+    }
+    batch.samples_destinations.clear();batch.reports.clear();
+}
+} // namespace nx::nvn
