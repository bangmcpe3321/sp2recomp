+// SDL physical motion -> coherent, timestamp-driven 200 Hz nn::hid samples.
+#pragma once
+#include "mouse_gyro.h"
+namespace nx::plat {
+class ControllerMotion {
+    static constexpr uint64_t tick_ns=5000000, max_gap_ns=100000000;
+    static constexpr double tau=6.2831853071795864769, gravity=9.80665;
+    std::array<MouseGyroSample,16> history_{};
+    unsigned count_=0,head_=0;
+    uint64_t last_=0,next_=0,serial_=0,accel_time_=0,cal_start_=0;
+    bool started_=false,aligned_=false,calibrated_=false;
+    unsigned cal_count_=0;
+    double q_[4]={0,0,0,1},previous_[3]={},pending_[3]={},angle_[3]={};
+    double acceleration_[3]={0,0,-1},bias_[3]={},cal_sum_[3]={};
+    static bool finite(const float* v) {
+        return v&&std::isfinite(v[0])&&std::isfinite(v[1])&&std::isfinite(v[2]);
+    }
+    // SDL3 sensor.h defines a right-handed frame X right, Y up, Z toward user.
+    // Rotate that frame 90 degrees about X: (X,Z,-Y). Both angular velocity
+    // and acceleration use this proper rotation, preserving cross products.
+    // Source: SDL release-3.4.20/include/SDL3/SDL_sensor.h and
+    // src/joystick/hidapi/SDL_hidapi_switch.c, SendSensorUpdate.
+    static void map(const float* v,double* out,double scale=1) {
+        out[0]=v[0]*scale;out[1]=v[2]*scale;out[2]=-v[1]*scale;
+    }
+    void rotate(const double* radians) {
+        const double n=std::hypot(radians[0],radians[1],radians[2]);
+        if(n==0)return;
+        const double k=std::sin(n/2)/n,x=radians[0]*k,y=radians[1]*k,z=radians[2]*k,w=std::cos(n/2);
+        const double r[4]={q_[3]*x+q_[0]*w+q_[1]*z-q_[2]*y,
+            q_[3]*y-q_[0]*z+q_[1]*w+q_[2]*x,
+            q_[3]*z+q_[0]*y-q_[1]*x+q_[2]*w,
+            q_[3]*w-q_[0]*x-q_[1]*y-q_[2]*z};
+        double norm=0;for(double v:r)norm+=v*v;norm=std::sqrt(norm);
+        for(int i=0;i<4;++i)q_[i]=r[i]/norm;
+    }
+    void publish() {
+        MouseGyroSample s;s.sampling_number=++serial_;
+        for(int i=0;i<3;++i) {
+            angle_[i]+=pending_[i]/tau;s.angle[i]=float(angle_[i]);
+            s.velocity[i]=float(pending_[i]/tau*200);s.acceleration[i]=float(acceleration_[i]);
+        }
+        const double x=q_[0],y=q_[1],z=q_[2],w=q_[3];
+        const float m[9]={float(1-2*(y*y+z*z)),float(2*(x*y+z*w)),float(2*(x*z-y*w)),
+            float(2*(x*y-z*w)),float(1-2*(x*x+z*z)),float(2*(y*z+x*w)),
+            float(2*(x*z+y*w)),float(2*(y*z-x*w)),float(1-2*(x*x+y*y))};
+        std::copy(m,m+9,s.direction);
+        if(count_)head_=(head_+1)%16;history_[head_]=s;count_=std::min(count_+1,16u);
+        for(double& v:pending_)v=0;
+    }
+public:
+    // Caller serializes all access. Disconnect/focus handoff should reset,
+    // preventing earlier sensor samples or bias from leaking into a new session.
+    void reset() { *this=ControllerMotion{}; }
+    void push_accel(uint64_t timestamp_ns,const float* values) {
+        if(!finite(values)||(accel_time_&&timestamp_ns<=accel_time_))return;
+        double mapped[3];map(values,mapped,1/gravity);
+        const double norm=std::hypot(mapped[0],mapped[1],mapped[2]);
+        if(norm>16)return; // corrupt samples cannot produce unbounded guest input
+        accel_time_=timestamp_ns;std::copy(mapped,mapped+3,acceleration_);
+        if(!aligned_&&norm>.7&&norm<1.3) {
+            // Shortest rotation taking measured body gravity onto world -Z.
+            // Gravity determines tilt only; initial yaw remains the zero reference.
+            const double ax=mapped[0]/norm,ay=mapped[1]/norm,az=mapped[2]/norm;
+            const double w=1-az;
+            if(w<1e-8) {q_[0]=1;q_[1]=q_[2]=q_[3]=0;}
+            else {
+                const double n=std::sqrt(ay*ay+ax*ax+w*w);
+                q_[0]=-ay/n;q_[1]=ax/n;q_[2]=0;q_[3]=w/n;
+            }
+            aligned_=true;
+        }
+    }
+    void push_gyro(uint64_t timestamp_ns,const float* values) {
+        if(!finite(values)||(started_&&timestamp_ns<=last_))return;
+        double raw[3];map(values,raw);
+        // Match the game camera horizontal direction; apply before quaternion
+        // integration so rate, angle and orientation remain one coherent stream.
+        raw[2]=-raw[2];
+        const double speed=std::hypot(raw[0],raw[1],raw[2]);
+        if(speed>100)return;
+        const bool gap=started_&&timestamp_ns-last_>max_gap_ns;
+        const double an=std::hypot(acceleration_[0],acceleration_[1],acceleration_[2]);
+        if(!calibrated_) {
+            const bool stationary=speed<.1&&an>.9&&an<1.1&&accel_time_&&
+                timestamp_ns>=accel_time_&&timestamp_ns-accel_time_<max_gap_ns;
+            if(!stationary||gap) {
+                // Calibration is a startup operation. Once actual movement
+                // begins, never freeze later deliberate slow aiming to retry it.
+                if(cal_count_||speed>=.1)calibrated_=true;
+                cal_count_=0;cal_start_=0;for(double& v:cal_sum_)v=0;
+            }
+            if(stationary) {
+                if(!cal_count_)cal_start_=timestamp_ns;
+                ++cal_count_;for(int i=0;i<3;++i)cal_sum_[i]+=raw[i];
+                if(timestamp_ns-cal_start_>=1000000000&&cal_count_>=100) {
+                    for(int i=0;i<3;++i)bias_[i]=cal_sum_[i]/cal_count_;
+                    calibrated_=true;
+                }
+                // Suppress drift while a stationary startup bias is measured.
+                for(double& v:raw)v=0;
+            }
+        } else for(int i=0;i<3;++i)raw[i]-=bias_[i];
+        if(!started_||gap) {
+            started_=true;last_=timestamp_ns;next_=timestamp_ns+tick_ns;
+            count_=head_=0;for(double& v:pending_)v=0;
+            std::copy(raw,raw+3,previous_);publish();return;
+        }
+        // Trapezoid-resample irregular device timestamps onto exact 5 ms ticks.
+        // Reads never advance time or integrate a rate repeatedly.
+        uint64_t cursor=last_;
+        while(cursor<timestamp_ns) {
+            const uint64_t end=std::min(next_,timestamp_ns);
+            const double a=double(cursor-last_)/double(timestamp_ns-last_);
+            const double b=double(end-last_)/double(timestamp_ns-last_);
+            double delta[3];
+            for(int i=0;i<3;++i) {
+                delta[i]=(previous_[i]+(raw[i]-previous_[i])*(a+b)*.5)*double(end-cursor)*1e-9;
+                pending_[i]+=delta[i];
+            }
+            rotate(delta);cursor=end;
+            if(cursor==next_) {publish();next_+=tick_ns;}
+        }
+        last_=timestamp_ns;std::copy(raw,raw+3,previous_);
+    }
+    unsigned read_states(unsigned sensor,MouseGyroSample* out,unsigned capacity) const {
+        if(sensor>=2||!out)return 0;
+        const unsigned n=std::min({capacity,count_,16u});
+        for(unsigned i=0;i<n;++i)out[i]=history_[(head_+16-i)%16];
+        return n;
+    }
+};
+} // namespace nx::plat
