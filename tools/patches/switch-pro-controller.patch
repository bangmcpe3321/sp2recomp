+// SDL3's positional controls converted to the Nintendo HID layout. No SDL dependency.
+#pragma once
+#include "platform.h"
+#include <algorithm>
+namespace nx::plat {
+inline int32_t switch_pro_axis(int16_t raw, bool invert = false) {
+    int value = invert ? -int(raw) : int(raw);
+    value = std::clamp(value, -32767, 32767);
+    constexpr int deadzone = 3500;
+    int magnitude = value < 0 ? -value : value;
+    if (magnitude <= deadzone) return 0;
+    magnitude = (magnitude - deadzone) * 32767 / (32767 - deadzone);
+    return value < 0 ? -magnitude : magnitude;
+}
+inline PadState map_switch_pro(const bool (&buttons)[15], const int16_t (&axes)[6]) {
+    // SDL3 SOUTH,EAST,WEST,NORTH,BACK,GUIDE,START,LSTICK,RSTICK,LSHOULDER,
+    // RSHOULDER,DPAD_UP,DPAD_DOWN,DPAD_LEFT,DPAD_RIGHT (SDL 3.4.20).
+    constexpr uint64_t masks[15] = {kB,kA,kY,kX,kMinus,0,kPlus,kStickL,kStickR,kL,kR,kUp,kDown,kLeft,kRight};
+    PadState result{};
+    for (unsigned i=0;i<15;++i) if (buttons[i]) result.buttons |= masks[i];
+    if (axes[4] > 16384) result.buttons |= kZL;
+    if (axes[5] > 16384) result.buttons |= kZR;
+    result.lx=switch_pro_axis(axes[0]); result.ly=switch_pro_axis(axes[1],true);
+    result.rx=switch_pro_axis(axes[2]); result.ry=switch_pro_axis(axes[3],true);
+    return result;
+}
+} // namespace nx::plat
