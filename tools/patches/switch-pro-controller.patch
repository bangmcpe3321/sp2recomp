+// Optional Windows native Nintendo Switch Pro input through SDL3 HIDAPI.
+// All SDL calls belong to one worker; game threads only read locked snapshots.
+#pragma once
+#include "switch_pro_mapping.h"
+#include "controller_motion.h"
+#include <windows.h>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <mutex>
+#include <thread>
+#include <cstddef>
+#include <cstring>
+#include <cwchar>
+
+namespace nx::plat {
+namespace switch_pro_detail {
+// Narrow SDL 3.4.20 ABI declarations, checked against the official headers.
+struct Gamepad;
+struct SensorEvent {
+    uint32_t type, reserved;
+    uint64_t timestamp;
+    uint32_t which;
+    int32_t sensor;
+    float data[3];
+    uint64_t sensor_timestamp;
+};
+union Event { uint32_t type; SensorEvent sensor; uint8_t padding[128]; };
+static_assert(sizeof(Event)==128 && sizeof(SensorEvent)==48);
+static_assert(offsetof(SensorEvent,sensor_timestamp)==40);
+struct Api {
+    HMODULE dll{};
+    void (*SetMainReady)(){};
+    bool (*SetHint)(const char*,const char*){};
+    bool (*Init)(uint32_t){};
+    void (*Quit)(){};
+    const char* (*GetError)(){};
+    bool (*PollEvent)(Event*){};
+    uint32_t* (*GetGamepads)(int*){};
+    void (*Free)(void*){};
+    uint16_t (*GetGamepadVendorForID)(uint32_t){};
+    uint16_t (*GetGamepadProductForID)(uint32_t){};
+    Gamepad* (*OpenGamepad)(uint32_t){};
+    void (*CloseGamepad)(Gamepad*){};
+    bool (*GamepadConnected)(Gamepad*){};
+    const char* (*GetGamepadName)(Gamepad*){};
+    bool (*GetGamepadButton)(Gamepad*,int){};
+    int16_t (*GetGamepadAxis)(Gamepad*,int){};
+    bool (*GamepadHasSensor)(Gamepad*,int){};
+    bool (*SetGamepadSensorEnabled)(Gamepad*,int,bool){};
+    bool load() {
+        // Search beside this executable first, never the current working directory.
+        wchar_t path[32768];
+        DWORD n=GetModuleFileNameW(nullptr,path,32768);
+        if (!n || n>=32768) return false;
+        wchar_t* slash=wcsrchr(path,L'\\');
+        if (!slash || slash-path > 32758) return false;
+        wcscpy(slash+1,L"SDL3.dll");
+        dll=LoadLibraryExW(path,nullptr,LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR|LOAD_LIBRARY_SEARCH_SYSTEM32);
+        if (!dll) return false;
+#define NX_SDL_LOAD(member,name) member=reinterpret_cast<decltype(member)>(GetProcAddress(dll,name)); if(!member) return false
+        NX_SDL_LOAD(SetMainReady,"SDL_SetMainReady"); NX_SDL_LOAD(SetHint,"SDL_SetHint");
+        NX_SDL_LOAD(Init,"SDL_Init"); NX_SDL_LOAD(Quit,"SDL_Quit"); NX_SDL_LOAD(GetError,"SDL_GetError");
+        NX_SDL_LOAD(PollEvent,"SDL_PollEvent"); NX_SDL_LOAD(GetGamepads,"SDL_GetGamepads"); NX_SDL_LOAD(Free,"SDL_free");
+        NX_SDL_LOAD(GetGamepadVendorForID,"SDL_GetGamepadVendorForID"); NX_SDL_LOAD(GetGamepadProductForID,"SDL_GetGamepadProductForID");
+        NX_SDL_LOAD(OpenGamepad,"SDL_OpenGamepad"); NX_SDL_LOAD(CloseGamepad,"SDL_CloseGamepad");
+        NX_SDL_LOAD(GamepadConnected,"SDL_GamepadConnected"); NX_SDL_LOAD(GetGamepadName,"SDL_GetGamepadName");
+        NX_SDL_LOAD(GetGamepadButton,"SDL_GetGamepadButton"); NX_SDL_LOAD(GetGamepadAxis,"SDL_GetGamepadAxis");
+        NX_SDL_LOAD(GamepadHasSensor,"SDL_GamepadHasSensor"); NX_SDL_LOAD(SetGamepadSensorEnabled,"SDL_SetGamepadSensorEnabled");
+#undef NX_SDL_LOAD
+        return true;
+    }
+    ~Api() { if(dll) FreeLibrary(dll); }
+};
+inline uint64_t now_ns() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+struct State {
+    std::mutex mutex;
+    std::once_flag once;
+    std::atomic<bool> stop{false};
+    std::thread worker;
+    bool connected=false, gyro=false, focused=true;
+    PadState pad{};
+    ControllerMotion motion;
+    uint64_t gyro_events=0, accel_events=0, last_gyro_ns=0, focus_since_ns=0;
+    ~State() { stop=true; if(worker.joinable()) worker.join(); }
+    void run() {
+        Api api;
+        if(!api.load()) { nx::log("Switch Pro: SDL3.dll unavailable beside executable; XInput remains available"); return; }
+        // SDL_SetMainReady establishes this as SDL's main thread on Windows.
+        // No SDL video subsystem is used; the existing Win32 window is independent.
+        api.SetMainReady();
+        api.SetHint("SDL_JOYSTICK_HIDAPI","1");
+        api.SetHint("SDL_JOYSTICK_HIDAPI_SWITCH","1");
+        api.SetHint("SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS","1");
+        if(!api.Init(0x2000)) { nx::log("Switch Pro: SDL initialization failed: %s",api.GetError()); return; }
+        Gamepad* device=nullptr;
+        uint32_t device_id=0;
+        uint64_t next_discovery=0, sensor_origin=0, local_origin=0;
+        while(!stop.load()) {
+            if(device && !api.GamepadConnected(device)) {
+                api.CloseGamepad(device); device=nullptr; device_id=0;
+                std::lock_guard<std::mutex> lock(mutex);
+                connected=false; gyro=false; pad={}; motion.reset(); last_gyro_ns=0;
+                nx::log("Switch Pro: disconnected");
+            }
+            uint64_t now=now_ns();
+            if(!device && now>=next_discovery) {
+                next_discovery=now+1000000000ull;
+                int count=0; uint32_t* ids=api.GetGamepads(&count);
+                for(int i=0;ids && i<count;++i) {
+                    if(api.GetGamepadVendorForID(ids[i])!=0x057e || api.GetGamepadProductForID(ids[i])!=0x2009) continue;
+                    device=api.OpenGamepad(ids[i]);
+                    if(device) { device_id=ids[i]; break; }
+                }
+                api.Free(ids);
+                if(device) {
+                    bool accelerometer=api.GamepadHasSensor(device,1) && api.SetGamepadSensorEnabled(device,1,true);
+                    bool gyroscope=api.GamepadHasSensor(device,2) && api.SetGamepadSensorEnabled(device,2,true);
+                    sensor_origin=local_origin=0;
+                    std::lock_guard<std::mutex> lock(mutex);
+                    motion.reset(); connected=true; gyro=gyroscope; pad={};
+                    gyro_events=accel_events=last_gyro_ns=0;
+                    nx::log("Switch Pro: connected %s (native HIDAPI; accel=%d gyro=%d)",api.GetGamepadName(device),int(accelerometer),int(gyroscope));
+                }
+            }
+            Event event{};
+            // PollEvent pumps SDL on its initializing thread. Each Switch packet can
+            // carry three sensor readings; consume all, retaining device timestamps.
+            while(api.PollEvent(&event)) {
+                if(!device || event.type!=0x659 || event.sensor.which!=device_id) continue;
+                const auto& sample=event.sensor;
+                if(sample.sensor!=1 && sample.sensor!=2) continue;
+                uint64_t stamp=sample.sensor_timestamp ? sample.sensor_timestamp : sample.timestamp;
+                if(!sensor_origin) { sensor_origin=stamp; local_origin=now_ns(); }
+                if(stamp<sensor_origin) continue;
+                uint64_t normalized=local_origin+(stamp-sensor_origin);
+                std::lock_guard<std::mutex> lock(mutex);
+                // Discard sensor packets queued before focus/capture handoff.
+                const uint64_t arrival=now_ns();
+                if(!focused || normalized<focus_since_ns ||
+                    (arrival>normalized && arrival-normalized>=100000000ull)) continue;
+                if(sample.sensor==1) { motion.push_accel(normalized,sample.data); ++accel_events; }
+                else { motion.push_gyro(normalized,sample.data); ++gyro_events; last_gyro_ns=now_ns(); }
+            }
+            if(device) {
+                bool buttons[15]{}; int16_t axes[6]{};
+                for(int i=0;i<15;++i) buttons[i]=api.GetGamepadButton(device,i);
+                for(int i=0;i<6;++i) axes[i]=api.GetGamepadAxis(device,i);
+                std::lock_guard<std::mutex> lock(mutex);
+                pad=map_switch_pro(buttons,axes);
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        }
+        if(device) api.CloseGamepad(device);
+        api.Quit();
+    }
+};
+inline State& state() { static State instance; return instance; }
+} // namespace switch_pro_detail
+inline void start_switch_pro() {
+    auto& s=switch_pro_detail::state();
+    std::call_once(s.once,[&s] {
+        const char* value=std::getenv("NX_SWITCH_PRO");
+        if(value && !std::strcmp(value,"0")) return;
+        s.worker=std::thread([&s]{s.run();});
+    });
+}
+inline void set_switch_pro_focus(bool focused) {
+    auto& s=switch_pro_detail::state(); std::lock_guard<std::mutex> lock(s.mutex);
+    if(s.focused!=focused) { s.focused=focused; s.motion.reset(); s.last_gyro_ns=0; s.focus_since_ns=switch_pro_detail::now_ns(); }
+}
+inline bool read_switch_pro(PadState& result) {
+    auto& s=switch_pro_detail::state(); std::lock_guard<std::mutex> lock(s.mutex);
+    if(!s.connected) return false;
+    result=s.pad; return true;
+}
+inline unsigned read_switch_pro_motion(unsigned sensor,MouseGyroSample* out,unsigned capacity) {
+    auto& s=switch_pro_detail::state(); std::lock_guard<std::mutex> lock(s.mutex);
+    return s.connected && s.gyro && s.focused && switch_pro_detail::now_ns()-s.last_gyro_ns < 100000000ull ? s.motion.read_states(sensor,out,capacity) : 0;
+}
+} // namespace nx::plat
